<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>dev.kaloyanyordanov</groupId>
    <artifactId>llm-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>llm-gateway</name>
    <description>Anthropic-compatible LLM gateway: proxy, auth, rate limiting, caching, usage accounting</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Persistence (§A2): JPA is the locked choice over raw JDBC. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Flyway (§A2): SQL-first, forward-only migrations.
             spring-boot-flyway carries Boot 4's Flyway auto-configuration, which
             was split out of the core autoconfigure module (a first-party Boot-4
             re-modularization, pre-approved under §A2). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers (§A2): real Postgres for integration tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x renamed modules: postgresql -> testcontainers-postgresql,
             junit-jupiter -> testcontainers-junit-jupiter. Versions managed by the
             Spring Boot BOM (testcontainers-bom 2.0.x). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Spring Boot 4 extracted the MockMvc test slice (@AutoConfigureMockMvc,
          @WebMvcTest) out of spring-boot-starter-test into this dedicated,
          BOM-managed starter. Same first-party testing capability as Boot 3, new
          module coordinates. Version is managed by the Spring Boot parent BOM.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Expose dependency artifact paths as properties (e.g. the Mockito
                 jar) so we can pass Mockito as an explicit -javaagent below. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-agent-paths</id>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire: attach Mockito as an explicit JVM agent. On JDK 25 the
                 dynamic self-attach Mockito used by default is deprecated and warns;
                 attaching it here removes the warning. @{argLine} preserves the
                 JaCoCo agent that jacoco:prepare-agent injects. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- user.timezone=UTC: deterministic tests, and avoids the
                         Postgres 17 JDBC rejection of deprecated tz aliases
                         (e.g. the host's "Europe/Kiev", renamed to "Europe/Kyiv"). -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Duser.timezone=UTC</argLine>
                </configuration>
            </plugin>

            <!-- JaCoCo: failing coverage gate bound to verify (85% line / 80% branch). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <configuration>
                    <excludes>
                        <!-- Bootstrap class: main() launches Spring and is not
                             meaningfully unit-testable, so it is excluded from
                             coverage (standard practice). -->
                        <exclude>dev/kaloyanyordanov/llmgateway/Application.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              PIT mutation testing: ENFORCING gate from Phase 1 (>=70%), bound to
              verify. Phase 1 introduces the first real branching logic (auth), and
              real logic should not sit un-mutation-tested. (This is one phase
              earlier than the Phase-0 estimate — a tightening, permitted by
              pre-flight §3 "ratchet up, never down".)
              Integration/Spring-context tests (*IntegrationTest) are excluded from
              PIT's test set: they spin Testcontainers/full contexts, which are slow
              and non-deterministic under mutation analysis. Mutation coverage of
              the logic is provided by fast unit tests; JaCoCo (not PIT) counts the
              integration tests for line/branch coverage.
            -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.20.0</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.3</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>dev.kaloyanyordanov.llmgateway.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>dev.kaloyanyordanov.llmgateway.*</param>
                    </targetTests>
                    <!-- Bootstrap class is excluded from mutation, as from coverage. -->
                    <excludedClasses>
                        <param>dev.kaloyanyordanov.llmgateway.Application</param>
                    </excludedClasses>
                    <excludedTestClasses>
                        <param>*IntegrationTest</param>
                    </excludedTestClasses>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <mutationThreshold>70</mutationThreshold>
                </configuration>
                <executions>
                    <execution>
                        <id>pit-mutation-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>mutationCoverage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Checkstyle: failing gate bound to verify (0 violations, severity=error). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <!-- Override the plugin's bundled (old) Checkstyle with a modern one. -->
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>10.21.4</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                    <!-- Main sources only: JavadocPackage would otherwise demand a
                         package-info.java in every test package. -->
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- SpotBugs: failing gate bound to verify (effort=max, threshold=low). -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.9.6.0</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Low</threshold>
                    <failOnError>true</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
